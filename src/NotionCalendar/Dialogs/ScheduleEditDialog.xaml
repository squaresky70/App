<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NotionCalendar.Dialogs.ScheduleEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NotionCalendar.Models"
    Title="일정"
    Background="{StaticResource BgCanvasBrush}"
    CloseButtonText="취소"
    DefaultButton="Primary"
    Foreground="{StaticResource TextPrimaryBrush}"
    PrimaryButtonText="저장"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <!--  노션 느낌으로 흰 배경 + 큰 라운드  -->
        <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#EDEDEB" />
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>

        <!--  버튼 강조색을 앱 액센트로 통일  -->
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#2383E2" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3B92E6" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1C6FC0" />
    </ContentDialog.Resources>

    <Grid Width="376" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  제목  -->
        <TextBox
            x:Name="TitleBox"
            Grid.Row="0"
            Padding="12,10"
            Background="{StaticResource BgSubtleBrush}"
            BorderBrush="{StaticResource BorderBrushStrong}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusSm}"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="{StaticResource TextPrimaryBrush}"
            PlaceholderText="제목을 입력하세요"
            TextChanged="OnTitleChanged" />

        <!--  시작일  -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="시작일" />
            <CalendarDatePicker
                x:Name="StartDatePicker"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                CornerRadius="{StaticResource RadiusSm}"
                DateChanged="OnStartDateChanged"
                DateFormat="{}{year.full}년 {month.integer}월 {day.integer}일"
                PlaceholderText="날짜 선택" />
        </Grid>

        <!--  종료일  -->
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="종료일" />
            <CalendarDatePicker
                x:Name="EndDatePicker"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                CornerRadius="{StaticResource RadiusSm}"
                DateChanged="OnEndDateChanged"
                DateFormat="{}{year.full}년 {month.integer}월 {day.integer}일"
                PlaceholderText="시작일과 같음" />
        </Grid>

        <!--  하루 종일 스위치  -->
        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="하루 종일" />
            <ToggleSwitch
                x:Name="AllDaySwitch"
                Grid.Column="1"
                MinWidth="0"
                OffContent=""
                OnContent=""
                Toggled="OnAllDayToggled" />
        </Grid>

        <!--  시작 / 종료 시각  -->
        <Grid
            x:Name="TimeRow"
            Grid.Row="4"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="시간" />
            <TimePicker
                x:Name="StartTimePicker"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                ClockIdentifier="24HourClock"
                CornerRadius="{StaticResource RadiusSm}"
                MinuteIncrement="5" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="–" />
            <TimePicker
                x:Name="EndTimePicker"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                ClockIdentifier="24HourClock"
                CornerRadius="{StaticResource RadiusSm}"
                MinuteIncrement="5" />
        </Grid>

        <!--  색상  -->
        <Grid Grid.Row="5" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="색상" />
            <!--
                ItemsRepeater/ItemsControl 은 이 다이얼로그(ContentDialog) 안에서 어떤 이유로도
                항목을 하나도 실체화하지 않는 문제가 있었다(바인딩 유무와 무관하게 0개로 렌더링).
                색상은 정확히 9개로 고정이라 목록 컨트롤이 필요 없으므로 정적 XAML로 직접 선언한다.
            -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="7">
                <Grid Width="26" Height="26" Background="Transparent" Tag="gray" Tapped="OnColorTapped" AutomationProperties.Name="회색" ToolTipService.ToolTip="회색">
                    <Border x:Name="RingGray" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="13" Opacity="0" />
                    <Border Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#9B9A97" CornerRadius="8" />
                </Grid>
                <Grid Width="26" Height="26" Background="Transparent" Tag="brown" Tapped="OnColorTapped" AutomationProperties.Name="갈색" ToolTipService.ToolTip="갈색">
                    <Border x:Name="RingBrown" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="13" Opacity="0" />
                    <Border Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#A97C5D" CornerRadius="8" />
                </Grid>
                <Grid Width="26" Height="26" Background="Transparent" Tag="orange" Tapped="OnColorTapped" AutomationProperties.Name="주황" ToolTipService.ToolTip="주황">
                    <Border x:Name="RingOrange" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="13" Opacity="0" />
                    <Border Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#D9730D" CornerRadius="8" />
                </Grid>
                <Grid Width="26" Height="26" Background="Transparent" Tag="yellow" Tapped="OnColorTapped" AutomationProperties.Name="노랑" ToolTipService.ToolTip="노랑">
                    <Border x:Name="RingYellow" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="13" Opacity="0" />
                    <Border Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#DFAB01" CornerRadius="8" />
                </Grid>
                <Grid Width="26" Height="26" Background="Transparent" Tag="green" Tapped="OnColorTapped" AutomationProperties.Name="초록" ToolTipService.ToolTip="초록">
                    <Border x:Name="RingGreen" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="13" Opacity="0" />
                    <Border Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#4DAB6D" CornerRadius="8" />
                </Grid>
                <Grid Width="26" Height="26" Background="Transparent" Tag="blue" Tapped="OnColorTapped" AutomationProperties.Name="파랑" ToolTipService.ToolTip="파랑">
                    <Border x:Name="RingBlue" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="13" Opacity="0" />
                    <Border Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#2383E2" CornerRadius="8" />
                </Grid>
                <Grid Width="26" Height="26" Background="Transparent" Tag="purple" Tapped="OnColorTapped" AutomationProperties.Name="보라" ToolTipService.ToolTip="보라">
                    <Border x:Name="RingPurple" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="13" Opacity="0" />
                    <Border Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#9065B0" CornerRadius="8" />
                </Grid>
                <Grid Width="26" Height="26" Background="Transparent" Tag="pink" Tapped="OnColorTapped" AutomationProperties.Name="분홍" ToolTipService.ToolTip="분홍">
                    <Border x:Name="RingPink" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="13" Opacity="0" />
                    <Border Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#C14C8A" CornerRadius="8" />
                </Grid>
                <Grid Width="26" Height="26" Background="Transparent" Tag="red" Tapped="OnColorTapped" AutomationProperties.Name="빨강" ToolTipService.ToolTip="빨강">
                    <Border x:Name="RingRed" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="13" Opacity="0" />
                    <Border Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#E03E3E" CornerRadius="8" />
                </Grid>
            </StackPanel>
        </Grid>

        <!--  메모  -->
        <TextBox
            x:Name="NoteBox"
            Grid.Row="6"
            Height="78"
            Padding="12,9"
            AcceptsReturn="True"
            Background="{StaticResource BgSubtleBrush}"
            BorderBrush="{StaticResource BorderBrushStrong}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusSm}"
            FontSize="{StaticResource FontSizeBody}"
            Foreground="{StaticResource TextPrimaryBrush}"
            PlaceholderText="메모 (선택)"
            TextWrapping="Wrap" />
    </Grid>
</ContentDialog>
