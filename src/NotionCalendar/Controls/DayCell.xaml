<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NotionCalendar.Controls.DayCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NotionCalendar.Models"
    mc:Ignorable="d">

    <!--
        좌우 안쪽 여백을 0 으로 둬야 일정 막대가 칸 끝까지 닿아 옆 칸과 이어져 보인다.
        그래서 날짜 숫자와 "+N개" 쪽에만 따로 여백을 준다.
    -->
    <Border
        x:Name="RootBorder"
        Padding="0,4,0,4"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="1"
        CornerRadius="{StaticResource RadiusMd}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  날짜 숫자 (오늘이면 동그란 강조 배경) + 공휴일 이름  -->
            <Grid Margin="5,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="DayBadge"
                    Height="22"
                    MinWidth="22"
                    Padding="6,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    CornerRadius="11">
                    <TextBlock
                        x:Name="DayText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </Border>

                <!--  음력 날짜 (바탕화면 위젯에서만 보인다)  -->
                <TextBlock
                    x:Name="LunarText"
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="9.5"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="HolidayText"
                    Grid.Column="2"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource HolidayBrush}"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Visibility="Collapsed" />
            </Grid>

            <!--
                좌우 -2: 칸 테두리(1px)가 밀어낸 만큼 되돌리고 1px 더 겹친다.
                열 너비가 소수점이라 반올림에 따라 1px 틈이 생기는데, 겹쳐 두면 그 틈이 사라진다.
            -->
            <Grid Grid.Row="1" Margin="-2,3,-2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    일정 막대. 레인마다 높이가 같아야 옆 칸과 이어져 보이므로 Height 를 고정한다.
                    Margin 이 음수면 칸 안쪽 여백을 넘어 옆 칸의 막대와 맞닿는다.
                -->
                <ItemsRepeater x:Name="ChipsRepeater" VerticalAlignment="Top">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ScheduleSegment">
                            <Border
                                Height="17"
                                Margin="{x:Bind Margin}"
                                Padding="{x:Bind Padding}"
                                Background="{x:Bind Background}"
                                CornerRadius="{x:Bind Corner}">
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{x:Bind Foreground}"
                                    LineHeight="14"
                                    MaxLines="1"
                                    Text="{x:Bind Text}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--  +N개 더보기  -->
                <TextBlock
                    x:Name="MoreText"
                    Grid.Row="1"
                    Margin="10,2,0,0"
                    FontSize="10"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
