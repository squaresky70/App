<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NotionCalendar.Controls.DayCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NotionCalendar.Models"
    mc:Ignorable="d">

    <Border
        x:Name="RootBorder"
        Padding="5,4,5,4"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="1"
        CornerRadius="{StaticResource RadiusMd}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  날짜 숫자 (오늘이면 동그란 강조 배경)  -->
            <Border
                x:Name="DayBadge"
                Height="22"
                MinWidth="22"
                Padding="6,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                CornerRadius="11">
                <TextBlock
                    x:Name="DayText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold" />
            </Border>

            <Grid Grid.Row="1" Margin="0,3,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  일정 칩 미리보기  -->
                <ItemsRepeater x:Name="ChipsRepeater" VerticalAlignment="Top">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ScheduleItem">
                            <Border
                                Padding="6,1,6,2"
                                Background="{x:Bind ChipBackground, Mode=OneWay}"
                                CornerRadius="5">
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{x:Bind ChipForeground, Mode=OneWay}"
                                    LineHeight="14"
                                    MaxLines="1"
                                    Text="{x:Bind ChipText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--  +N개 더보기  -->
                <TextBlock
                    x:Name="MoreText"
                    Grid.Row="1"
                    Margin="5,2,0,0"
                    FontSize="10"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
