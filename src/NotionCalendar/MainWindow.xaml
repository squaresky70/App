<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotionCalendar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NotionCalendar.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{StaticResource BgCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            ================= 커스텀 타이틀바 =================
            끌어서 창을 옮기는 영역(AppTitleBar)은 버튼 오른쪽부터다.
            제목 표시줄로 지정된 영역 위의 버튼은 클릭을 받지 못하므로 버튼과 겹치지 않게 칸을 나눴다.
        -->
        <Grid Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Margin="20,0,10,0"
                VerticalAlignment="Center"
                FontSize="12.5"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="캘린더" />

            <Button
                x:Name="WidgetButton"
                Grid.Column="1"
                Padding="8,3"
                VerticalAlignment="Center"
                Click="OnWidgetButtonClick"
                Style="{StaticResource ChipButtonStyle}"
                ToolTipService.ToolTip="바탕화면에 달력 위젯을 띄웁니다">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="&#xE71D;" />
                    <TextBlock
                        x:Name="WidgetButtonText"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="위젯 추가" />
                </StackPanel>
            </Button>

            <Grid
                x:Name="AppTitleBar"
                Grid.Column="2"
                Background="Transparent" />
        </Grid>

        <!--  ================= 본문 =================  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  달력  -->
            <Grid Grid.Column="0" Padding="22,0,10,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  헤더: 연/월 + 이동 버튼  -->
                <Grid Margin="0,4,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <!--  월: 누르면 1~12월 선택 표  -->
                        <Button
                            Margin="-6,0,-6,0"
                            Padding="6,0"
                            VerticalAlignment="Bottom"
                            Click="OnMonthTitleClick"
                            Style="{StaticResource ChipButtonStyle}"
                            ToolTipService.ToolTip="월 선택">
                            <TextBlock
                                FontSize="{StaticResource FontSizeTitle}"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{x:Bind VM.MonthTitle, Mode=OneWay}" />
                        </Button>
                        <!--  연도: 누르면 연도 선택 표  -->
                        <Button
                            Margin="0,0,-4,1"
                            Padding="4,1"
                            VerticalAlignment="Bottom"
                            Click="OnYearTitleClick"
                            Style="{StaticResource ChipButtonStyle}"
                            ToolTipService.ToolTip="연도 선택">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="{x:Bind VM.YearTitle, Mode=OneWay}" />
                        </Button>
                        <TextBlock
                            Margin="2,0,0,2"
                            VerticalAlignment="Bottom"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="{x:Bind VM.SelectedDateDiffText, Mode=OneWay}" />

                        <!--  주요 일정 D-Day (우측 패널에서 ☆ 를 눌러 지정, 여러 개 가능)  -->
                        <Border
                            Width="1"
                            Height="16"
                            Margin="6,0,2,3"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource BorderBrushStrong}"
                            Visibility="{x:Bind VM.PinnedVisibility, Mode=OneWay}" />
                        <!--  디데이가 가까운 순(우선순위)으로 최대 3개  -->
                        <ItemsRepeater
                            VerticalAlignment="Bottom"
                            ItemsSource="{x:Bind VM.HeaderDDays}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <!--
                                    누르면 그 일정 날짜로 달력을 옮기고 선택한다.
                                    ItemsRepeater + x:Bind 템플릿은 DataContext 를 채우지 않으므로 직접 넣어 준다.
                                -->
                                <DataTemplate x:DataType="models:PinnedDDay">
                                    <Button
                                        Padding="5,0"
                                        VerticalAlignment="Bottom"
                                        Click="OnPinnedDDayClick"
                                        DataContext="{x:Bind}"
                                        Style="{StaticResource ChipButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind ToolTip}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock
                                                VerticalAlignment="Bottom"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource AccentBrush}"
                                                Text="{x:Bind DDayText}" />
                                            <TextBlock
                                                MaxWidth="130"
                                                Margin="0,0,0,2"
                                                VerticalAlignment="Bottom"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!--  3개를 넘는 나머지 주요 일정 수  -->
                        <TextBlock
                            Margin="2,0,0,2"
                            VerticalAlignment="Bottom"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="{x:Bind VM.HiddenDDayText, Mode=OneWay}"
                            ToolTipService.ToolTip="디데이가 먼 주요 일정은 상단에 3개까지만 보여요"
                            Visibility="{x:Bind VM.HiddenDDayVisibility, Mode=OneWay}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="OnTodayClick"
                        Content="오늘"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="오늘로 이동 (Ctrl+T)" />
                </Grid>

                <!--  요일 머리글  -->
                <Grid x:Name="WeekdayHeader" Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="6,0,0,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SundayBrush}"
                        Text="일" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="월" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="화" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="6,0,0,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="수" />
                    <TextBlock
                        Grid.Column="4"
                        Margin="6,0,0,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="목" />
                    <TextBlock
                        Grid.Column="5"
                        Margin="6,0,0,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="금" />
                    <TextBlock
                        Grid.Column="6"
                        Margin="6,0,0,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SaturdayBrush}"
                        Text="토" />
                </Grid>

                <!--  날짜 격자 (좌우 스와이프로 달 이동)  -->
                <Border
                    Grid.Row="2"
                    Padding="4"
                    Background="{StaticResource BgCanvasBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}">
                    <Grid
                        x:Name="SwipeHost"
                        Background="Transparent"
                        PointerCanceled="OnSwipePointerLost"
                        PointerCaptureLost="OnSwipePointerLost"
                        PointerMoved="OnSwipePointerMoved"
                        PointerPressed="OnSwipePointerPressed"
                        PointerReleased="OnSwipePointerReleased"
                        PointerWheelChanged="OnPointerWheelChanged">
                        <!--  DaysGrid 의 셀은 코드에서 생성한다 (42칸 고정 재사용)  -->
                        <Grid x:Name="DaysGrid" />
                    </Grid>
                </Border>

                <!--  스와이프 안내  -->
                <TextBlock
                    Grid.Row="3"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="좌우로 스와이프하거나 마우스 휠을 굴려 달을 넘기세요" />
            </Grid>

            <!--  우측 일정 패널  -->
            <Border
                Grid.Column="1"
                Width="322"
                Margin="6,0,18,18"
                Padding="18,16,18,16"
                Background="{StaticResource BgSubtleBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLg}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  선택한 날짜  -->
                    <StackPanel Spacing="2">
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="{x:Bind VM.SelectedDateTitle, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{x:Bind VM.SelectedWeekdayTitle, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="·" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="{x:Bind VM.ScheduleCountText, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="·"
                                Visibility="{x:Bind VM.SelectedHolidayVisibility, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource HolidayBrush}"
                                Text="{x:Bind VM.SelectedHolidayName, Mode=OneWay}"
                                Visibility="{x:Bind VM.SelectedHolidayVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  일정 추가  -->
                    <Button
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Click="OnAddScheduleClick"
                        Content="+  일정 추가"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTipService.ToolTip="새 일정 (Ctrl+N)" />

                    <!--  일정 목록  -->
                    <Grid Grid.Row="2">
                        <ScrollViewer
                            Padding="0,0,4,0"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater x:Name="ScheduleList">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ScheduleItem">
                                        <Border
                                            Padding="12,10"
                                            DataContext="{x:Bind Mode=OneWay}"
                                            Background="{StaticResource BgCanvasBrush}"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            DoubleTapped="OnScheduleCardDoubleTapped"
                                            Tapped="OnScheduleCardTapped">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--  색상 막대  -->
                                                <Border
                                                    Width="3"
                                                    MinHeight="30"
                                                    VerticalAlignment="Stretch"
                                                    Background="{x:Bind AccentBar, Mode=OneWay}"
                                                    CornerRadius="2" />

                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock
                                                        FontSize="13.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        MaxLines="2"
                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Text="{x:Bind TimeText, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        Foreground="{StaticResource TextTertiaryBrush}"
                                                        MaxLines="2"
                                                        Text="{x:Bind Note, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Top"
                                                    Orientation="Horizontal">
                                                    <Button
                                                        Click="OnPinScheduleClick"
                                                        Content="{x:Bind PinGlyph, Mode=OneWay}"
                                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                        FontSize="12"
                                                        Foreground="{x:Bind PinBrush, Mode=OneWay}"
                                                        Style="{StaticResource GhostIconButtonStyle}"
                                                        Tapped="OnPinButtonTapped"
                                                        ToolTipService.ToolTip="주요 일정(D-Day)으로 지정" />
                                                    <Button
                                                        Click="OnDeleteScheduleClick"
                                                        Content="&#xE74D;"
                                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                        FontSize="12"
                                                        Style="{StaticResource GhostIconButtonStyle}"
                                                        Tapped="OnDeleteButtonTapped"
                                                        ToolTipService.ToolTip="삭제" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <!--  비어 있을 때  -->
                        <StackPanel
                            Margin="0,28,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Spacing="6"
                            Visibility="{x:Bind VM.EmptyStateVisibility, Mode=OneWay}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="아직 일정이 없습니다" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="날짜를 더블클릭해도 추가할 수 있어요" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
